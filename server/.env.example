# ==============================================================================
# ACADEMIC PORTAL - ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env and populate with production values.
# DO NOT commit production secrets or real API credentials to source control.
# ==============================================================================

# Server Runtime Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Bulk Import & File Upload Configuration
IMPORT_BATCH_SIZE=500
MAX_UPLOAD_SIZE_MB=25

# Security & Authentication (JWT)
# Recommended: Generate a 64+ character random hexadecimal or base64 secret string
JWT_SECRET=your-secure-random-jwt-secret-minimum-32-chars-change-in-production

# PostgreSQL Database Connection (Prisma)
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=<SCHEMA>
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/academic_portal?schema=public"

# Notification Provider Mode
# Set to 'false' in production to use live carrier gateways (SMS / Meta WhatsApp Cloud API)
# Set to 'true' in development/testing for zero-cost in-memory mock delivery simulation
MOCK_NOTIFICATIONS="true"

# Redis & BullMQ Asynchronous Notification Queue
# BullMQ provides multi-attempt retries, exponential backoff, and concurrency control.
# If Redis is unavailable, the server automatically falls back to in-memory resilient queuing.
ENABLE_REDIS="false"
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_PASSWORD=""

# SMS Gateway Provider Integration (e.g., Twilio, MSG91, Textlocal)
SMS_API_KEY=""
SMS_SENDER_ID="COLLEGE"
SMS_API_URL="https://api.sms-gateway.com/v1/send"
SMS_TIMEOUT_MS=10000

# Meta WhatsApp Business Cloud API Integration
# Graph API endpoint: https://graph.facebook.com/{WHATSAPP_API_VERSION}/{WHATSAPP_PHONE_NUMBER_ID}/messages
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_API_VERSION="v19.0"
WHATSAPP_TEMPLATE_NAME="academic_notification"
WHATSAPP_TIMEOUT_MS=10000
